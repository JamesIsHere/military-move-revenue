    "locators": ["LOC-0011", "LOC-0012", "LOC-0013", "LOC-0014", "LOC-0015", "LOC-0016", "LOC-0017"],
    "claims": ["CLM-0013", "CLM-0014", "CLM-0015", "CLM-0016", "CLM-0017", "CLM-0018", "CLM-0019"]
