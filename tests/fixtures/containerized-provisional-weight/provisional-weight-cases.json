  },
  "cases": [
    {
      "id": "CONTAINERIZED-PROVISIONAL-VALID-001",
      "description": "The provisional new net is lower than the final initial net.",
      "expected": {"status": "FINAL", "provisional_net_weight": "7500", "initial_net_weight": "8000", "selected_weight": "7500", "selected_source": "CONTAINERIZED_PROVISIONAL_WEIGHT"}
    },
    {
      "id": "CONTAINERIZED-PROVISIONAL-VALID-002",
      "description": "The final initial net remains the lower reference when the provisional new net is higher.",
      "record_mutations": [
        {"op": "set", "collection": "weight_ticket_measurements", "id": "WTM-CRW-NEW-GROSS", "field": "weight_value", "value": "12500"}
      ],
      "expected": {"status": "FINAL", "provisional_net_weight": "8500", "initial_net_weight": "8000", "selected_weight": "8000", "selected_source": "INITIAL_SCALE_WEIGHT"}
    },
    {
      "id": "CONTAINERIZED-PROVISIONAL-VALID-003",
      "description": "Equal initial and provisional weights are exposed as a tie.",
      "record_mutations": [
        {"op": "set", "collection": "weight_ticket_measurements", "id": "WTM-CRW-NEW-GROSS", "field": "weight_value", "value": "12000"}
      ],
      "expected": {"status": "FINAL", "provisional_net_weight": "8000", "initial_net_weight": "8000", "selected_weight": "8000", "selected_source": "TIE"}
    },
    {
      "id": "CONTAINERIZED-PROVISIONAL-VALID-004",
      "description": "Fractional pounds are subtracted and compared exactly without unstated rounding.",
      "record_mutations": [
        {"op": "set", "collection": "weight_ticket_measurements", "id": "WTM-CRW-ORIGINAL-TARE", "field": "weight_value", "value": "4000.10"},
        {"op": "set", "collection": "weight_ticket_measurements", "id": "WTM-CRW-NEW-GROSS", "field": "weight_value", "value": "11500.35"}
      ],
      "expected": {"status": "FINAL", "provisional_net_weight": "7500.25", "initial_net_weight": "8000", "selected_weight": "7500.25", "selected_source": "CONTAINERIZED_PROVISIONAL_WEIGHT"}
    },
    {
      "id": "CONTAINERIZED-PROVISIONAL-VALID-005",
      "description": "Later new-tare completion facts do not rewrite or alter the CLM-0027 provisional result.",
      "record_mutations": [
        {"op": "set", "collection": "weight_ticket_measurements", "id": "WTM-CRW-NEW-TARE", "field": "weight_value", "value": "9999"},
        {"op": "set", "collection": "containerized_reweigh_completion_events", "id": "CRWC-001", "field": "reimbursement_tolerance_status", "value": "UNRESOLVED_TEST_VALUE"}
      ],
      "expected": {"status": "FINAL", "provisional_net_weight": "7500", "initial_net_weight": "8000", "selected_weight": "7500", "selected_source": "CONTAINERIZED_PROVISIONAL_WEIGHT"}
    },
    {
      "id": "CONTAINERIZED-PROVISIONAL-BLOCKED-001",
      "description": "Unreviewed original-tare ticket evidence blocks calculation and selection.",
      "record_mutations": [
        {"op": "set", "collection": "evidence_links", "id": "EVL-CRW-ORIGINAL-TARE", "field": "review_status", "value": "PENDING"}
      ],
      "expected": {"status": "BLOCKED", "blocked_reasons": ["ORIGINAL_TARE_EVIDENCE_MISSING_OR_UNREVIEWED"]}
    },
    {
      "id": "CONTAINERIZED-PROVISIONAL-BLOCKED-002",
      "description": "Unreviewed new-gross ticket evidence blocks calculation and selection.",
      "record_mutations": [
        {"op": "set", "collection": "evidence_links", "id": "EVL-CRW-NEW-GROSS", "field": "review_status", "value": "PENDING"}
      ],
      "expected": {"status": "BLOCKED", "blocked_reasons": ["NEW_GROSS_EVIDENCE_MISSING_OR_UNREVIEWED"]}
    },
    {
      "id": "CONTAINERIZED-PROVISIONAL-BLOCKED-003",
      "description": "A case not marked ready cannot execute the deterministic package.",
      "record_mutations": [
        {"op": "set", "collection": "containerized_reweigh_cases", "id": "CRW-001", "field": "provisional_readiness_status", "value": "PENDING_REVIEW"}
      ],
      "expected": {"status": "BLOCKED", "blocked_reasons": ["CONTAINERIZED_PROVISIONAL_CASE_NOT_READY"]}
    },
    {
      "id": "CONTAINERIZED-PROVISIONAL-BLOCKED-004",
      "description": "A blocked final-initial-weight input propagates its evidence blocker.",
      "initial_weight_mutations": [
        {"path": "tickets.0.true_copy_available", "value": false}
      ],
      "expected": {"status": "BLOCKED", "blocked_reasons": ["INITIAL_WEIGHT_RESULT_BLOCKED"], "upstream_blocked_reasons": ["MISSING_TRUE_TICKET_COPY"]}
    },
    {
      "id": "CONTAINERIZED-PROVISIONAL-BLOCKED-005",
      "description": "A new gross that would not produce a positive provisional net is held for review.",
      "record_mutations": [
        {"op": "set", "collection": "weight_ticket_measurements", "id": "WTM-CRW-NEW-GROSS", "field": "weight_value", "value": "4000"}
      ],
      "expected": {"status": "BLOCKED", "blocked_reasons": ["NEW_GROSS_NOT_GREATER_THAN_ORIGINAL_TARE"]}
    },
    {
      "id": "CONTAINERIZED-PROVISIONAL-ERROR-001",
      "description": "A binary numeric new-gross value is rejected before calculation.",
      "record_mutations": [
        {"op": "set", "collection": "weight_ticket_measurements", "id": "WTM-CRW-NEW-GROSS", "field": "weight_value", "value": 11500.25}
      ],
      "expected": {"input_error_contains": "must be an exact decimal JSON string"}
    },
    {
      "id": "CONTAINERIZED-PROVISIONAL-ERROR-002",
      "description": "A non-pound new-gross unit is rejected.",
      "record_mutations": [
        {"op": "set", "collection": "weight_ticket_measurements", "id": "WTM-CRW-NEW-GROSS", "field": "weight_unit", "value": "kg"}
      ],
      "expected": {"input_error_contains": "new gross unit must be lb"}
    },
    {
      "id": "CONTAINERIZED-PROVISIONAL-ERROR-003",
      "description": "A new-gross observation dated before the original tare is rejected.",
      "record_mutations": [
        {"op": "set", "collection": "weighing_events", "id": "WEV-CRW-NEW-GROSS-001", "field": "occurred_at_or_date", "value": "2026-05-19T14:00:00Z"}
      ],
      "expected": {"input_error_contains": "original tare must precede new gross"}
    },
    {
      "id": "CONTAINERIZED-PROVISIONAL-ERROR-004",
      "description": "Tampered initial-weight provenance is rejected.",
      "initial_result_mutations": [
        {"path": "provenance.0.source_claim_id", "value": "CLM-TAMPERED"}
      ],
      "expected": {"input_error_contains": "initial_weight_result provenance mismatch"}
    },
    {
      "id": "CONTAINERIZED-PROVISIONAL-ERROR-005",
      "description": "A result whose immutable package ID is changed is rejected by the contract validator.",
      "result_mutations": [
        {"path": "rule_package_id", "value": "RP-TAMPERED"}
      ],
      "expected": {"result_error_contains": "package mismatch"}
    }
  ]
