{
  "fixture_set": "SYNTHETIC_CONTAINERIZED_PROVISIONAL_WEIGHT_CASES",
  "containerized_facts_fixture_path": "tests/fixtures/logical-schema/containerized-reweigh-facts.json",
  "initial_weight_fixture_path": "tests/fixtures/weight-determination/initial-scale-weight-cases.json",
  "source_basis": {
    "claims": ["CLM-0027"],
