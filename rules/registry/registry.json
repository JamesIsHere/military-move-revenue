    },
    {
      "id": "RULE-DIRECT-DELIVERY-SIT-DAY-PERCENT",
      "rule_package_id": "RP-DP3-2026-INITIAL-DRAFT",
      "rule_kind": "quantity_calculation",
      "expression_language": "decision-expression-v0",
      "expression": "candidate_authorized_sit_days := ROUND(transit_days * 0.7, 0)",
      "outcome_type": "quantity_calendar_day",
      "effective_date_fact_type": "actual_pickup_date",
      "implementation_status": "not_implemented",
      "publication_status": "draft",
      "blocked_by_conflict_ids": ["CF-0002"]
    },
    {
      "id": "RULE-DOMESTIC-ITEM-CODE-CURRENCY-2026",
      "rule_package_id": "RP-DP3-2026-INITIAL-DRAFT",
      "rule_kind": "controlled_vocabulary_selection",
      "expression_language": "decision-expression-v0",
      "expression": "candidate_item_code_source := SV-DP3-ITEM-CODES-2022-08-12",
      "outcome_type": "source_version_id",
      "effective_date_fact_type": "actual_pickup_date",
      "implementation_status": "not_implemented",
      "publication_status": "draft",
      "blocked_by_conflict_ids": ["CF-0003"]
    },
    {
      "id": "RULE-INITIAL-NET-SCALE-WEIGHT",
      "rule_package_id": "RP-DP3-2026-WEIGHT-1",
      "rule_kind": "quantity_calculation",
      "expression_language": "python-decimal-v1",
      "expression": "net_weight_lb := gross_weight_lb - tare_weight_lb",
      "outcome_type": "quantity_lb",
      "effective_date_fact_type": "actual_pickup_date",
      "implementation_status": "implemented",
      "publication_status": "published",
      "blocked_by_conflict_ids": []
    },
    {
      "id": "RULE-INITIAL-SCALE-METHOD",
      "rule_package_id": "RP-DP3-2026-WEIGHT-1",
      "rule_kind": "method_eligibility",
      "expression_language": "python-decimal-v1",
      "expression": "vehicle_scale OR ((platform_scale OR warehouse_scale) AND (containerized_at_no_additional_cost OR net_weight_lb <= 1000))",
      "outcome_type": "boolean",
      "effective_date_fact_type": "actual_pickup_date",
      "implementation_status": "implemented",
      "publication_status": "published",
      "blocked_by_conflict_ids": []
    },
    {
      "id": "RULE-INITIAL-WEIGHING-CONDITIONS",
      "rule_package_id": "RP-DP3-2026-WEIGHT-1",
      "rule_kind": "fact_validation",
      "expression_language": "python-decimal-v1",
      "expression": "same_vehicle_or_container AND (non_vehicle_scale OR (equipment_consistent AND vehicle_unoccupied AND compliant_fuel_state))",
      "outcome_type": "boolean",
      "effective_date_fact_type": "actual_pickup_date",
      "implementation_status": "implemented",
      "publication_status": "published",
      "blocked_by_conflict_ids": []
    },
    {
      "id": "RULE-INITIAL-WEIGHT-TICKET-SUFFICIENCY",
      "rule_package_id": "RP-DP3-2026-WEIGHT-1",
      "rule_kind": "evidence_validation",
      "expression_language": "python-decimal-v1",
      "expression": "all_determining_tickets_present AND all_required_fields_present AND certified_scales AND combined_ticket_only_if_same_scale",
      "outcome_type": "boolean",
      "effective_date_fact_type": "actual_pickup_date",
      "implementation_status": "implemented",
      "publication_status": "published",
      "blocked_by_conflict_ids": []
    },
    {
      "id": "RULE-AUTOMATIC-REWEIGH-REQUIRED",
      "rule_package_id": "RP-DP3-2026-AUTO-REWEIGH-1",
      "rule_kind": "eligibility_decision",
      "expression_language": "python-decimal-v1",
      "expression": "(grade_band = E1_THRU_E5 AND initial_weight_lb >= 4000) OR (grade_band IN (E6_THRU_O10, DOW_CIVILIAN) AND initial_weight_lb >= 7000)",
      "outcome_type": "boolean",
      "effective_date_fact_type": "actual_pickup_date",
      "implementation_status": "implemented",
      "publication_status": "published",
      "blocked_by_conflict_ids": []
    },
    {
      "id": "RULE-REWEIGH-FEE-TOLERANCE-QUALIFIES",
      "rule_package_id": "RP-DP3-2026-INITIAL-DRAFT",
      "rule_kind": "fee_eligibility_condition",
      "expression_language": "decision-expression-v0",
      "expression": "candidate := reweigh_net >= initial_net OR (reweigh_net < initial_net AND applicable_tolerance(branch_weight_fact, initial_net - reweigh_net, lower_net))",
      "outcome_type": "boolean",
      "effective_date_fact_type": "actual_pickup_date",
      "implementation_status": "not_implemented",
      "publication_status": "draft",
      "blocked_by_conflict_ids": ["CF-0004"]
    },
    {
      "id": "RULE-CONTAINERIZED-REWEIGH-REIMBURSEMENT-TOLERANCE",
      "rule_package_id": "RP-DP3-2026-INITIAL-DRAFT",
      "rule_kind": "reimbursement_eligibility_condition",
      "expression_language": "decision-expression-v0",
      "expression": "candidate := new_tare > original_tare AND applicable_tolerance_exceeded(branch_weight_fact, new_tare - original_tare, lower_tare)",
      "outcome_type": "boolean",
      "effective_date_fact_type": "actual_pickup_date",
      "implementation_status": "not_implemented",
      "publication_status": "draft",
      "blocked_by_conflict_ids": ["CF-0004"]
    }
  ],
