  "rules": [
    {
      "id": "RULE-SIT-ACCESSORIAL-RATE-VERSION-DATE",
      "rule_package_id": "RP-DP3-2026-INITIAL-DRAFT",
      "rule_kind": "effective_date_selection",
      "expression_language": "decision-expression-v0",
      "expression": "candidate_rate_table_date := actual_pickup_date",
