    {
      "id": "RULE-DOMESTIC-TRANSIT-TABLE-2026",
      "rule_package_id": "RP-DP3-2026-INITIAL-DRAFT",
      "rule_kind": "reference_version_selection",
      "expression_language": "decision-expression-v0",
      "expression": "candidate_transit_source := SV-DP3-2026-TRANSIT-2025-12-08",
